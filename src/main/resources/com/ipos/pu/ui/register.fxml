<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ipos.pu.ui.controller.RegisterController">

    <!-- Left brand panel -->
    <VBox alignment="CENTER" prefWidth="320" spacing="16"
          style="-fx-background-color: #1e1e2e; -fx-padding: 48;">
        <ImageView fitWidth="160" fitHeight="160" preserveRatio="true">
            <image><Image url="/com/ipos/pu/ui/icon.png"/></image>
        </ImageView>
        <Label text="Pharmaceutical Online Portal"
               style="-fx-text-fill: #a0a0b8; -fx-font-size: 13px; -fx-text-alignment: center; -fx-wrap-text: true;" wrapText="true"/>
    </VBox>

    <!-- Right form panel -->
    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="14"
          style="-fx-background-color: #f0f2f5; -fx-padding: 60 80;">
        <Label text="Create an account" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1e1e2e;"/>
        <Label text="Choose your membership type" style="-fx-font-size: 13px; -fx-text-fill: #888; -fx-padding: 0 0 10 0;"/>

        <Button text="Non-Commercial (Individual)" onAction="#onNonCommercialClicked"
                style="-fx-pref-width: 340; -fx-pref-height: 48; -fx-background-color: #ffffff; -fx-text-fill: #1e1e2e; -fx-font-size: 14px; -fx-font-weight: bold; -fx-border-color: #d0d0de; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Button text="Commercial (Business)" onAction="#onCommercialClicked"
                style="-fx-pref-width: 340; -fx-pref-height: 48; -fx-background-color: #1e1e2e; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>

        <HBox alignment="CENTER" spacing="6" style="-fx-padding: 8 0 0 0;">
            <Label text="Already have an account?" style="-fx-font-size: 12px; -fx-text-fill: #888;"/>
            <Button text="Sign In" onAction="#onBackClicked"
                    style="-fx-background-color: transparent; -fx-text-fill: #1e1e2e; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;"/>
        </HBox>
    </VBox>
</HBox>
