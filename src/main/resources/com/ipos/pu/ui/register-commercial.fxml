<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ipos.pu.ui.controller.RegisterCommercialController">

    <!-- Left brand panel -->
    <VBox alignment="CENTER" prefWidth="320" spacing="16"
          style="-fx-background-color: #1e1e2e; -fx-padding: 48;">
        <ImageView fitWidth="160" fitHeight="160" preserveRatio="true">
            <image><Image url="/com/ipos/pu/ui/icon.png"/></image>
        </ImageView>
        <Label text="Pharmaceutical Online Portal"
               style="-fx-text-fill: #a0a0b8; -fx-font-size: 13px; -fx-text-alignment: center;" wrapText="true"/>
    </VBox>

    <!-- Right form panel -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" hbarPolicy="NEVER"
                style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
    <VBox alignment="CENTER" spacing="8"
          style="-fx-background-color: #f0f2f5; -fx-padding: 30 80;">
        <Label text="Commercial Registration" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1e1e2e;"/>
        <Label text="Register your business" style="-fx-font-size: 13px; -fx-text-fill: #888; -fx-padding: 0 0 4 0;"/>

        <Label text="Email" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TextField fx:id="emailField" promptText="business@example.com"
                   style="-fx-pref-width: 340; -fx-pref-height: 36; -fx-background-color: #ffffff; -fx-border-color: #d0d0de; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px;"/>

        <Label text="Company Name" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TextField fx:id="companyNameField"
                   style="-fx-pref-width: 340; -fx-pref-height: 36; -fx-background-color: #ffffff; -fx-border-color: #d0d0de; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px;"/>

        <Label text="Companies House Registration Number" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TextField fx:id="companyRegField"
                   style="-fx-pref-width: 340; -fx-pref-height: 36; -fx-background-color: #ffffff; -fx-border-color: #d0d0de; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px;"/>

        <Label text="Business Address" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TextArea fx:id="addressField" promptText="Street address&#10;City&#10;Postcode"
                  style="-fx-pref-width: 340; -fx-pref-height: 80; -fx-background-color: #ffffff; -fx-border-color: #d0d0de; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px;"
                  wrapText="true"/>

        <Label fx:id="errorLabel" style="-fx-text-fill: #c0392b; -fx-font-size: 12px;" wrapText="true" maxWidth="340"/>
        <Label fx:id="successLabel" style="-fx-text-fill: #27ae60; -fx-font-size: 12px;" wrapText="true" maxWidth="340"/>

        <Button text="Submit Application" onAction="#onRegisterClicked"
                style="-fx-pref-width: 340; -fx-pref-height: 40; -fx-background-color: #1e1e2e; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>

        <HBox alignment="CENTER" spacing="6" style="-fx-padding: 4 0 0 0;">
            <Button text="Back to options" onAction="#onBackClicked"
                    style="-fx-background-color: transparent; -fx-text-fill: #1e1e2e; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;"/>
        </HBox>
    </VBox>
    </ScrollPane>
</HBox>
