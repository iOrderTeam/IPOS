<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ipos.pu.ui.controller.LoginController">

    <!-- Left brand panel -->
    <VBox alignment="CENTER" prefWidth="320" spacing="16"
          style="-fx-background-color: #1e1e2e; -fx-padding: 48;">
        <ImageView fitWidth="160" fitHeight="160" preserveRatio="true">
            <image><Image url="/com/ipos/pu/ui/icon.png"/></image>
        </ImageView>
        <Label text="Pharmaceutical Online Portal"
               style="-fx-text-fill: #a0a0b8; -fx-font-size: 13px; -fx-text-alignment: center; -fx-wrap-text: true;" wrapText="true"/>
    </VBox>

    <!-- Right form panel -->
    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="14"
          style="-fx-background-color: #f0f2f5; -fx-padding: 60 80;">
        <Label text="Welcome back" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1e1e2e;"/>
        <Label text="Sign in to your account" style="-fx-font-size: 13px; -fx-text-fill: #888; -fx-padding: 0 0 10 0;"/>

        <Label text="Email" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TextField fx:id="emailField" promptText="you@example.com"
                   style="-fx-pref-width: 340; -fx-pref-height: 38; -fx-background-color: #ffffff; -fx-border-color: #d0d0de; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px;"/>

        <Label text="Password" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
        <PasswordField fx:id="passwordField" promptText="Password"
                       style="-fx-pref-width: 340; -fx-pref-height: 38; -fx-background-color: #ffffff; -fx-border-color: #d0d0de; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px;"/>

        <Label fx:id="errorLabel" style="-fx-text-fill: #c0392b; -fx-font-size: 12px;"/>

        <Button text="Sign In" onAction="#onLoginClicked"
                style="-fx-pref-width: 340; -fx-pref-height: 40; -fx-background-color: #1e1e2e; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>

        <HBox alignment="CENTER" spacing="6" style="-fx-padding: 8 0 0 0;">
            <Label text="Don't have an account?" style="-fx-font-size: 12px; -fx-text-fill: #888;"/>
            <Button text="Register" onAction="#onBackClicked"
                    style="-fx-background-color: transparent; -fx-text-fill: #1e1e2e; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;"/>
        </HBox>
    </VBox>
</HBox>
