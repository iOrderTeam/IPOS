<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ipos.pu.ui.controller.PromotionsController"
      style="-fx-background-color: #f0f2f5;">

    <!-- Sidebar -->
    <VBox prefWidth="200" minWidth="200" maxWidth="200" spacing="4"
          style="-fx-background-color: #1e1e2e; -fx-padding: 0;">

        <VBox alignment="CENTER" style="-fx-padding: 24 16 20 16; -fx-border-color: transparent transparent #2e2e42 transparent; -fx-border-width: 1;">
            <ImageView fitWidth="100" fitHeight="100" preserveRatio="true">
                <image><Image url="/com/ipos/pu/ui/icon.png"/></image>
            </ImageView>
        </VBox>

        <VBox spacing="4" style="-fx-padding: 16 12 0 12;" VBox.vgrow="ALWAYS">
            <Button text="Catalogue" onAction="#onCatalogueClicked" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #a0a0b8; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-cursor: hand; -fx-background-radius: 8; -fx-graphic-text-gap: 10;">
                <graphic><FontIcon iconLiteral="fth-grid" iconSize="15" iconColor="#a0a0b8"/></graphic>
            </Button>
            <Button fx:id="cartNavButton" text="My Cart" onAction="#onCartClicked" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #a0a0b8; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-cursor: hand; -fx-background-radius: 8; -fx-graphic-text-gap: 10;">
                <graphic><FontIcon iconLiteral="fth-shopping-cart" iconSize="15" iconColor="#a0a0b8"/></graphic>
            </Button>
            <Button text="My Orders" onAction="#onOrdersClicked" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #a0a0b8; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-cursor: hand; -fx-background-radius: 8; -fx-graphic-text-gap: 10;">
                <graphic><FontIcon iconLiteral="fth-package" iconSize="15" iconColor="#a0a0b8"/></graphic>
            </Button>
            <Button text="Promotions" maxWidth="Infinity"
                    style="-fx-background-color: #2e2e52; -fx-text-fill: #ffffff; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-background-radius: 8; -fx-graphic-text-gap: 10;">
                <graphic><FontIcon iconLiteral="fth-percent" iconSize="15" iconColor="#ffffff"/></graphic>
            </Button>
            <Button fx:id="campaignsNavBtn" text="Campaigns" onAction="#onCampaignsClicked" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #a0a0b8; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-cursor: hand; -fx-background-radius: 8; -fx-graphic-text-gap: 10;">
                <graphic><FontIcon iconLiteral="fth-tag" iconSize="15" iconColor="#a0a0b8"/></graphic>
            </Button>
            <Button fx:id="reportsNavBtn" text="Reports" onAction="#onReportsClicked" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #a0a0b8; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-cursor: hand; -fx-background-radius: 8; -fx-graphic-text-gap: 10;">
                <graphic><FontIcon iconLiteral="fth-bar-chart-2" iconSize="15" iconColor="#a0a0b8"/></graphic>
            </Button>
        </VBox>

        <VBox style="-fx-padding: 0 12 20 12;">
            <Button text="Logout" onAction="#onLogoutClicked" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #a0a0b8; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-cursor: hand; -fx-background-radius: 8; -fx-graphic-text-gap: 10;">
                <graphic><FontIcon iconLiteral="fth-log-out" iconSize="15" iconColor="#a0a0b8"/></graphic>
            </Button>
        </VBox>
    </VBox>

    <!-- Main content -->
    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f0f2f5;">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #ffffff; -fx-padding: 16 24; -fx-border-color: transparent transparent #e0e0e8 transparent; -fx-border-width: 1;">
            <Label text="Current Promotions" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e1e2e;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <FontIcon iconLiteral="fth-user" iconSize="14" iconColor="#666"/>
            <Label fx:id="welcomeLabel" style="-fx-font-size: 13px; -fx-text-fill: #666;"/>
        </HBox>

        <!-- Content -->
        <VBox spacing="12" style="-fx-padding: 24;" VBox.vgrow="ALWAYS">

            <!-- Active campaigns table -->
            <VBox spacing="10"
                  style="-fx-background-color: #ffffff; -fx-padding: 16; -fx-background-radius: 10; -fx-border-color: #e0e0e8; -fx-border-radius: 10; -fx-border-width: 1;">
                <Label text="Active Promotions" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e1e2e;"/>
                <TableView fx:id="campaignsTable" prefHeight="160">
                    <columns>
                        <TableColumn fx:id="colCampName" text="Promotion" prefWidth="180"/>
                        <TableColumn fx:id="colCampDiscount" text="Discount" prefWidth="100"/>
                        <TableColumn fx:id="colCampEnd" text="Valid Until" prefWidth="140"/>
                        <TableColumn fx:id="colCampDesc" text="Description" prefWidth="260"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Discounted products for selected campaign -->
            <VBox spacing="10"
                  style="-fx-background-color: #ffffff; -fx-padding: 16; -fx-background-radius: 10; -fx-border-color: #e0e0e8; -fx-border-radius: 10; -fx-border-width: 1;"
                  VBox.vgrow="ALWAYS">
                <Label fx:id="campaignDetailLabel" text="Select a promotion above to view discounted products."
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e1e2e;"/>
                <TableView fx:id="productsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colProdName" text="Product" prefWidth="200"/>
                        <TableColumn fx:id="colProdOrigPrice" text="Original Price" prefWidth="120"/>
                        <TableColumn fx:id="colProdDiscPrice" text="Discounted Price" prefWidth="130"/>
                        <TableColumn fx:id="colProdStock" text="In Stock" prefWidth="90"/>
                    </columns>
                </TableView>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Add to Cart" onAction="#onAddToCartClicked"
                            style="-fx-pref-width: 140; -fx-pref-height: 34; -fx-background-color: #1e1e2e; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;"/>
                    <Label text="Qty:" style="-fx-text-fill: #555;"/>
                    <Button text="-" onAction="#onDecrementQty"
                            style="-fx-pref-width: 32; -fx-pref-height: 34; -fx-background-color: #e0e0e8; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    <TextField fx:id="quantityField" text="1" editable="false"
                               style="-fx-pref-width: 46; -fx-pref-height: 34; -fx-alignment: center; -fx-background-color: #f5f5fa; -fx-border-color: #e0e0e8; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                    <Button text="+" onAction="#onIncrementQty"
                            style="-fx-pref-width: 32; -fx-pref-height: 34; -fx-background-color: #e0e0e8; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    <Label fx:id="messageLabel" style="-fx-padding: 0 0 0 8;"/>
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</HBox>
