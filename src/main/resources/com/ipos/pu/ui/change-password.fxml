<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ipos.pu.ui.controller.ChangePasswordController">

    <!-- Left brand panel -->
    <VBox alignment="CENTER" prefWidth="320" spacing="16"
          style="-fx-background-color: #1e1e2e; -fx-padding: 48;">
        <ImageView fitWidth="160" fitHeight="160" preserveRatio="true">
            <image><Image url="/com/ipos/pu/ui/icon.png"/></image>
        </ImageView>
        <Label text="Pharmaceutical Online Portal"
               style="-fx-text-fill: #a0a0b8; -fx-font-size: 13px; -fx-text-alignment: center;" wrapText="true"/>
    </VBox>

    <!-- Right form panel -->
    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="14"
          style="-fx-background-color: #f0f2f5; -fx-padding: 60 80;">
        <Label text="Change Password" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1e1e2e;"/>
        <Label text="You must change your password before continuing."
               style="-fx-font-size: 13px; -fx-text-fill: #888; -fx-padding: 0 0 10 0;"/>

        <Label text="Current Password" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
        <PasswordField fx:id="currentPasswordField" promptText="Current password"
                       style="-fx-pref-width: 340; -fx-pref-height: 38; -fx-background-color: #ffffff; -fx-border-color: #d0d0de; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px;"/>

        <Label text="New Password" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
        <PasswordField fx:id="newPasswordField" promptText="New password"
                       style="-fx-pref-width: 340; -fx-pref-height: 38; -fx-background-color: #ffffff; -fx-border-color: #d0d0de; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px;"/>

        <Label text="Confirm New Password" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password"
                       style="-fx-pref-width: 340; -fx-pref-height: 38; -fx-background-color: #ffffff; -fx-border-color: #d0d0de; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px;"/>

        <Label fx:id="errorLabel" style="-fx-text-fill: #c0392b; -fx-font-size: 12px;"/>

        <Button text="Change Password" onAction="#onChangeClicked"
                style="-fx-pref-width: 340; -fx-pref-height: 40; -fx-background-color: #1e1e2e; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
    </VBox>
</HBox>
