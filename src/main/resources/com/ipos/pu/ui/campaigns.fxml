<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ipos.pu.ui.controller.CampaignController"
            style="-fx-background-color: #f4f4f4;">
    <top>
        <Label text="Promotional Campaigns"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 20;"/>
    </top>
    <center>
        <VBox spacing="12" style="-fx-padding: 20;">
            <TableView fx:id="campaignsTable" prefHeight="250">
                <columns>
                    <TableColumn fx:id="colName" text="Name" prefWidth="160"/>
                    <TableColumn fx:id="colDiscount" text="Discount %" prefWidth="100"/>
                    <TableColumn fx:id="colStart" text="Start Date" prefWidth="120"/>
                    <TableColumn fx:id="colEnd" text="End Date" prefWidth="120"/>
                    <TableColumn fx:id="colHits" text="Hits" prefWidth="80"/>
                </columns>
            </TableView>
            <Label text="Create New Campaign:" style="-fx-font-weight: bold;"/>
            <HBox spacing="8">
                <TextField fx:id="nameField" promptText="Name" prefWidth="150"/>
                <TextField fx:id="descField" promptText="Description" prefWidth="150"/>
                <TextField fx:id="discountField" promptText="Discount %" prefWidth="100"/>
            </HBox>
            <HBox spacing="8">
                <TextField fx:id="startField" promptText="Start (yyyy-MM-dd)" prefWidth="180"/>
                <TextField fx:id="endField" promptText="End (yyyy-MM-dd)" prefWidth="180"/>
            </HBox>
            <Label fx:id="messageLabel" style="-fx-text-fill: red;"/>
            <HBox spacing="10">
                <Button text="Create Campaign" onAction="#onCreateClicked"
                        style="-fx-pref-width: 160; -fx-pref-height: 35;"/>
                <Button text="Delete Selected" onAction="#onDeleteClicked"
                        style="-fx-pref-width: 160; -fx-pref-height: 35;"/>
                <Button text="Back" onAction="#onBackClicked"
                        style="-fx-pref-width: 100; -fx-pref-height: 35;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>