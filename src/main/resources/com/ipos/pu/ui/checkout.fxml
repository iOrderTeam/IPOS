<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ipos.pu.ui.controller.CheckoutController"
            style="-fx-background-color: #f4f4f4;">
    <center>
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 40;">
            <Label text="Checkout" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label fx:id="totalLabel" text="Total: £0.00" style="-fx-font-size: 16px;"/>
            <TextField fx:id="cardNameField" promptText="Cardholder Name" style="-fx-pref-width: 300;"/>
            <TextField fx:id="cardNumberField" promptText="Card Number" style="-fx-pref-width: 300;"/>
            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="expiryField" promptText="MM/YY" style="-fx-pref-width: 145;"/>
                <TextField fx:id="cvvField" promptText="CVV" style="-fx-pref-width: 145;"/>
            </HBox>
            <Label fx:id="messageLabel" style="-fx-text-fill: red;"/>
            <Button text="Confirm &amp; Pay" onAction="#onConfirmClicked"
                    style="-fx-pref-width: 300; -fx-pref-height: 40; -fx-font-size: 14px;"/>
            <Button text="Back to Cart" onAction="#onBackClicked"
                    style="-fx-pref-width: 300;"/>
        </VBox>
    </center>
</BorderPane>
